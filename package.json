{
  "name": "cartera-dashboard",
  "description": "Sistema de gestión de carteras y cobranza",
  "author": "Jhon Franklin Mejia Castro (RUC: 0950998104001)",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "pnpm electron:build && wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "tsc -p tsconfig.node.json && vite build --config electron.vite.config.ts",
    "start": "pnpm dev:renderer",
    "build": "vite build && tsc -p tsconfig.node.json && vite build --config electron.vite.config.ts",
    "build:installer": "pnpm build && electron-builder --win --config electron-builder.json5",
    "build:installer:mac": "pnpm build && electron-builder --mac --config electron-builder.json5",
    "build:all": "pnpm build && electron-builder --win --mac --config electron-builder.json5",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:integration": "vite build --config tests/config/vite.integration-test.config.ts && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/.build/integration/reconciliation.integration.cjs",
    "test:crm": "vite build --config tests/config/vite.crm-test.config.ts && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/.build/crm/crm-persistence.integration.cjs",
    "test:tasks": "pnpm test:tasks:domain && pnpm test:seguimientos && pnpm test:alertas-operativas",
    "test:tasks:domain": "vite build --config tests/config/vite.tasks-test.config.ts && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/.build/tasks/task-domain.integration.cjs",
    "test:seguimientos": "vite build --config tests/config/vite.seguimientos-test.config.ts && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/.build/seguimientos/seguimientos-renderer.integration.cjs",
    "test:alertas-operativas": "vite build --config tests/config/vite.alertas-operativas-test.config.ts && cross-env ELECTRON_RUN_AS_NODE=1 electron tests/.build/alertas-operativas/alertas-operativas.integration.cjs",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate.ps1",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "stats": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stats.ps1",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "deps": "pnpm outdated",
    "postinstall": "electron-builder install-app-deps",
    "health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "release:set": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-version.ps1",
    "release:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-release.ps1",
    "installer:verify-clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-clean-installer.ps1",
    "installer:usb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-usb-release.ps1",
    "data:clean-abonos": "node scripts/clean-abonos-copy.mjs",
    "data:credit-summary": "node scripts/credit-policy-summary.mjs",
    "verify:credit-import-route": "node scripts/verify-credit-import-route.mjs",
    "verify:credit-policy-ui": "node scripts/verify-credit-policy-ui.mjs",
    "verify:cancelled-documents-import": "node scripts/verify-cancelled-documents-import.mjs",
    "verify:collection-reconciliation": "node scripts/verify-collection-reconciliation.mjs",
    "verify:cancelled-documents-pdf": "node scripts/verify-cancelled-documents-pdf.mjs",
    "verify:production-isolation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-production-isolation.ps1",
    "verify:packaged-isolation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-production-isolation.ps1 -Packaged"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "better-sqlite3": "^12.6.2",
    "bindings": "^1.5.0",
    "chart.js": "^4.5.1",
    "file-uri-to-path": "^2.0.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prebuild-install": "^7.1.3",
    "typescript": "5.5.4",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^8.0.5"
  }
}
